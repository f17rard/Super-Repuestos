# Copia este archivo como .env y completa los valores. NUNCA subas .env a Git.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave que solo vive en el servidor (Project Settings > API)
SUPABASE_KEY=TU_CLAVE_DE_SUPABASE

# Opcional: solo si T1 (Machado) nombra las tablas distinto
# TABLA_VEHICULOS=vehiculos
# TABLA_REPUESTOS=repuestos
# TABLA_COMPATIBILIDAD=repuesto_vehiculo
# TABLA_INVENTARIO=inventario
# TABLA_SUCURSALES=sucursales
